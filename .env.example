# ============================================================
# KubeForge — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ============================================================

# Ambiente de execução
ENV=development

# Servidor uvicorn
HOST=0.0.0.0
PORT=8000

# Segurança da API
KUBEFORGE_API_KEY=troque-esta-chave

# Session store
# Em produção: use redis
# Em testes locais: pode usar memory
KUBEFORGE_SESSION_BACKEND=redis
REDIS_URL=redis://localhost:6379/0

# CORS — origens permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Diretório temporário para uploads (padrão: /tmp)
# UPLOAD_DIR=/tmp/kubeforge

# Tempo de vida da sessão em minutos (padrão: 30)
SESSION_TTL_MINUTES=30

# Diretório base permitido para source_type=folder e source_type=zip com source_value
# Deixe vazio em produção para desabilitar completamente modos de caminho local no servidor
KUBEFORGE_ALLOWED_SOURCE_DIR=
