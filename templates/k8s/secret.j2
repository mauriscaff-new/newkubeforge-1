{% if secret_vars %}
apiVersion: v1
kind: Secret
metadata:
  # Secret para variáveis sensíveis; preencher valores reais fora do repositório.
  name: {{ app_name }}-secret
  labels:
    app: {{ app_name }}
type: Opaque
# stringData evita codificação manual em base64 durante geração.
stringData:
{% for key in secret_vars %}
  {{ key }}: "SUBSTITUA_ESTE_VALOR"
{% endfor %}
{% endif %}
